{
    "name": "@keepsuit/cookie-solution",
    "version": "2.0.0",
    "description": "Cookie consent banner and policy web components for Laravel Cookie Solution, usable headless from any frontend.",
    "keywords": [
        "cookie",
        "cookie-consent",
        "cookie-banner",
        "gdpr",
        "consent",
        "laravel",
        "web-components",
        "lit"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/keepsuit/laravel-cookie-solution.git"
    },
    "author": "Fabio Capucci <fabio.cappuc@gmail.com>",
    "license": "MIT",
    "scripts": {
        "dev": "vite build --mode iife --watch",
        "build": "vite build && vite build --mode iife",
        "test": "node --test 'resources/js/**/*.test.mjs'",
        "format": "prettier --write resources/js",
        "prepublishOnly": "pnpm build"
    },
    "devDependencies": {
        "@microsoft/api-extractor": "^7.59.4",
        "@tailwindcss/postcss": "^4.3.3",
        "@tailwindcss/typography": "^0.5.20",
        "@types/node": "^26.6.5",
        "postcss": "^8.5.31",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "rollup-plugin-minify-html-literals": "^1.2.6",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^8.3.5",
        "vite-plugin-dts": "^5.1.2"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "lit": "^3.3.3"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "^11.28.9",
            "onFail": "warn"
        }
    }
}
